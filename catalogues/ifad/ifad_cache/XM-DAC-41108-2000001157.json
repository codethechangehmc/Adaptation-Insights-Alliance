{"xson":[{"/iati-activities/iati-activity":[{"/activity-date":[{"@iso-date":"2017-05-11","@type":"2"},{"@iso-date":"2027-06-30","@type":"3"}],"/activity-status@code":"2","/collaboration-type@code":"2","/contact-info":[{"/organisation/narrative":[{"1":"International Fund for Agricultural Development","@xml:lang":"EN"}],"/person-name/narrative":[{"1":"Olinga Biwole, Joseph Rostand","@xml:lang":"EN"}],"/telephone":[{"1":"+390654591"}],"/website":[{"1":"http://www.ifad.org"}],"@type":"1"}],"/default-aid-type":[{"@code":"C01","@vocabulary":"1"}],"/default-tied-status@code":"5","/description":[{"/narrative":[{"1":"The purpose of PREFER is to improve food security, nutrition and livelihoods of the rural poor in Comoros. To this end, the project will contribute to the sustainable increase of the availability of local food produce and farm incomes of the supported households. Specifically the project outcomes will be to: (i) improve the natural productive capital, resilience to climate change and structure farmer's organizations to better serve their members; and (ii) increase agricultural productivity for the targeted rural households. The PREFER project will be built around three main components, namely: (i) improving the productive natural capital and structure small holder farmers; (Ii) improving agricultural productivity and nutrition of the rural households; and (iii) coordination and project management of the project.","@xml:lang":"EN"}]}],"/document-link":[{"/category":[{"@code":"A02"},{"@code":"A07"},{"@code":"A08"}],"/language":[{"@code":"EN"}],"/title/narrative":[{"1":"Comoros 2000001157: PREFER Supervision Report December 2022","@xml:lang":"EN"}],"@format":"APPLICATION/PDF","@url":"https://operations.ifad.org/documents/654016/36cbcdaa-87e2-4172-b626-84a731dd6aa0"},{"/category":[{"@code":"A02"},{"@code":"A07"},{"@code":"A08"}],"/language":[{"@code":"EN"}],"/title/narrative":[{"1":"Comoros 2000001157: PREFER Supervision Report July 2024","@xml:lang":"EN"}],"@format