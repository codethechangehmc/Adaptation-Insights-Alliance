{"xson":[{"/iati-activities/iati-activity":[{"/activity-date":[{"@iso-date":"1998-12-02","@type":"2"},{"@iso-date":"2005-12-31","@type":"4"}],"/activity-status@code":"4","/collaboration-type@code":"2","/contact-info":[{"/department/narrative":[{"1":"ESA","@xml:lang":"EN"}],"/email":[{"1":"f.rispoli@ifad.org"}],"/job-title/narrative":[{"1":"Country Director","@xml:lang":"EN"}],"/organisation/narrative":[{"1":"International Fund for Agricultural Development","@xml:lang":"EN"}],"/person-name/narrative":[{"1":"Rispoli, Francesco","@xml:lang":"EN"}],"/telephone":[{"1":"+390654591"}],"/website":[{"1":"http://www.ifad.org"}],"@type":"1"}],"/default-aid-type":[{"@code":"C01","@vocabulary":"1"}],"/default-tied-status@code":"5","/description":[{"/narrative":[{"1":"The development goal of the programme is to increase the incomes and food security of\nsmallholder irrigating households and households in neighbouring communities on a sustainable basis.\nThis will be dependent on the achievement of outputs at both sectoral and scheme levels. At the sectoral level, the programme will aim to enhance the institutional and regulatory framework for smallholder irrigation; while, at the scheme level, it will look to ensure that farmers are themselves able to manage, operate and maintain fully operational and productive irrigation schemes. As a subsectoral programme with a seven-year implementation period, SISP will assist the Government from the short-, mediumand long-term perspective. Short-term requirements will be served by, and immediate benefits\nderived from, investments at the individual scheme and institutional levels. In the medium term, the\nprogramme¿s links with the ASIP will be expected to further improve the policy and legal framework\nfor smallholder irrigation and the institutional capacity to efficiently serve the subsector. Over the\nlong term, the programme will assist the Government in developing suitable methodologies and\npublic/private sector partnerships for coordinated, catchment-based planning for expanded command\narea development.","@xml:lang":"EN"}]}],"/document-link":[{"/category":[{"@code":"A12"}],"/description/narrative":[{"1":"More information on how IFAD publish IATI data to ensure the effectiveness of development.","@xml:lang":"EN"}],"/language":[{"@code":"EN"}],"/title/narrative":[{"1":"IATI documentation on IFAD corporate website","@xml:lang":"EN"}],"@format":"TEXT/HTML","@url":"/en/iati"},{"/category":[{"@code":"A12"}],"/description/narrative":[{"1":"The IFAD website includes a specific page for this project.  More information can be found here.","@xml:lang":"EN"}],"/language":[{"@code":"EN"}],"/title/narrative":[{"1":"Project page on IFAD corporate website","@xml:lang":"EN"}],"@format":"TEXT/HTML","@url":"/w/projects/1051"}],"/iati-identifier":"XM-DAC-41108-1100001051","/location":[{"/description/narrative":[{"1":"This point represents the centroid of the project area. For more detailed geographic information, please refer to the project page on the IFAD website.","@xml:lang":"EN"}],"/exactness@code":"1","/location-reach@code":"1","/name/narrative":[{"1":"Irrigation: Smallholder Irrigation Support Programme","@xml:lang":"EN"}],"/point/pos":"-19.00025527532675 29.868740438634664","/point@srsName":"http://www.opengis.net/def/crs/EPSG/0/4326"}],"/other-identifier":[{"@ref":"1100001051","@type":"A1"}],"/participating-org":[{"/narrative":[{"1":"International Fund for Agricultural Development","@xml:lang":"EN"}],"@activity-id":"XM-DAC-41108-1100001051","@ref":"XM-DAC-41108","@role":"1","@type":"40"}],"/recipient-country":[{"@code":"ZW","@percentage":100}],"/reporting-org/narrative":[{"1":"International Fund for Agricultural Development","@xml:lang":"EN"}],"/reporting-org@ref":"XM-DAC-41108","/reporting-org@type":"40","/sector":[{"@code":"311","@percentage":100,"@vocabulary":"2"}],"/title/narrative":[{"1":"Irrigation: Smallholder Irrigation Support Programme","@xml:lang":"EN"}],"/transaction":[{"/aid-type":[{"@code"