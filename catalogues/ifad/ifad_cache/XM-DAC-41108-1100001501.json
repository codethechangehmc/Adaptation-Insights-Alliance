{"xson":[{"/iati-activities/iati-activity":[{"/activity-date":[{"@iso-date":"2009-12-17","@type":"2"},{"@iso-date":"2017-12-31","@type":"4"}],"/activity-status@code":"4","/collaboration-type@code":"2","/contact-info":[{"/department/narrative":[{"1":"WCA","@xml:lang":"EN"}],"/email":[{"1":"m.norvilus@ifad.org"}],"/job-title/narrative":[{"1":"Country Director","@xml:lang":"EN"}],"/organisation/narrative":[{"1":"International Fund for Agricultural Development","@xml:lang":"EN"}],"/person-name/narrative":[{"1":"Norvilus, Marcelin","@xml:lang":"EN"}],"/telephone":[{"1":"+390654591"}],"/website":[{"1":"http://www.ifad.org"}],"@type":"1"}],"/default-aid-type":[{"@code":"C01","@vocabulary":"1"}],"/default-tied-status@code":"5","/description":[{"/narrative":[{"1":"The project's development goal is to reduce post-conflict poverty and food insecurity, and improve livelihoods and living conditions of rural communities. This will be achieved through the project objective to support short-term recovery of rural communities and their farming systems, while laying the basis for long-term rehabilitation and participatory development. The anticipated outputs of the project will include: (a) Restored and improved agricultural production capacity and household food security; (b) Strengthened community and farmer-based organizations; (c) Established mechanisms for participatory community development; and (d) Rehabilitated and expanded rural infrastructure.","@xml:lang":"EN"}]}],"/document-link":[{"/category":[{"@code":"A12"}],"/description/narrative":[{"1":"More information on how IFAD publish IATI data to ensure the effectiveness of development.","@xml:lang":"EN"}],"/language":[{"@code":"EN"}],"/title/narrative":[{"1":"IATI documentation on IFAD corporate website","@xml:lang":"EN"}],"@format":"TEXT/HTML","@url":"/en/iati"},{"/category":[{"@code":"A12"}],"/description/narrative":[{"1":"The IFAD website includes a specific page for this project.  More information can be found here.","@xm