{"xson":[{"/iati-activities/iati-activity":[{"/activity-date":[{"@iso-date":"2019-09-12","@type":"2"},{"@iso-date":"2029-09-30","@type":"3"}],"/activity-status@code":"2","/collaboration-type@code":"2","/contact-info":[{"/department/narrative":[{"1":"MCO-EGY","@xml:lang":"EN"}],"/email":[{"1":"t.al-eryani@ifad.org"}],"/job-title/narrative":[{"1":"Country Director","@xml:lang":"EN"}],"/organisation/narrative":[{"1":"International Fund for Agricultural Development","@xml:lang":"EN"}],"/person-name/narrative":[{"1":"Al-Eryani, Thoodan Abdulkarim Ali","@xml:lang":"EN"}],"/telephone":[{"1":"+390654591"}],"/website":[{"1":"http://www.ifad.org"}],"@type":"1"}],"/default-aid-type":[{"@code":"C01","@vocabulary":"1"}],"/default-tied-status@code":"5","/description":[{"/narrative":[{"1":"SNRLP¿s goal is to increase the food security, incomes and resilience of pastoralists, agropastoralists and smallholders engaging in joint natural resource-related activities. The objective is to increase production, secure access to natural resources for vulnerable users and improve the sustainability of natural resource-related livelihoods, by scaling up community-based natural resource governance practices, technologies and business models. The objective is aligned with the strategic objectives set forth in the results-based country strategic opportunities programme agreed between IFAD and Sudan by: (i) focusing on restoring ecosystems, strengthening resilience against climate change and facilitating target groups¿ access to basic agricultural services; and (ii) promoting diversification in smallholder livelihood systems, building the capacities of community institutions, producers, women and youth, and promoting target groups¿ access to rural finance.","@xml:lang":"EN"}]}],"/document-link":[{"/category":[{"@code":"A01"},{"@code":"A07"},{"@code":"A08"}],"/language":[{"@code":"EN"}],"/title/narrative":[{"1":"Sudan 2000002105: SNRLP Interim (Mid-term) Review Report June 2025","@xml:lang":"EN"}]