{"xson":[{"/iati-activities/iati-activity":[{"/activity-date":[{"@iso-date":"2024-12-11","@type":"2"},{"@iso-date":"2028-12-01","@type":"3"}],"/activity-status@code":"2","/collaboration-type@code":"2","/contact-info":[{"/department/narrative":[{"1":"MCO-EGY","@xml:lang":"EN"}],"/email":[{"1":"v.jijyan@ifad.org"}],"/job-title/narrative":[{"1":"Head MCO/Country Director","@xml:lang":"EN"}],"/organisation/narrative":[{"1":"International Fund for Agricultural Development","@xml:lang":"EN"}],"/person-name/narrative":[{"1":"Jijyan, Vrej","@xml:lang":"EN"}],"/telephone":[{"1":"+390654591"}],"/website":[{"1":"http://www.ifad.org"}],"@type":"1"}],"/default-aid-type":[{"@code":"C01","@vocabulary":"1"}],"/default-tied-status@code":"5","/description":[{"/narrative":[{"1":"CROWN aims at contributing to the enhancement of farmers climate resilience in the Nile Valley by decreasing poverty and improving food security and farmers adaptability to climate change to reduce climate change negative impacts on the livelihoods of the most vulnerable (women and youth).The development objective of CROMAP is the modernization of the water management network (upstream and on farm parts) as well as improvements in land use, agricultural production adaptation to climate change, farmers¿ resilience and rural livelihoods.CROWN aims also at facilitating small farmers¿ access to funds/ loans. The availability of financing facilities will enhance farmers¿ adaptive capacity to address climate change and its potential impact on agriculture for efficient production to increase yields and create opportunities for producing and marketing high value products.","@xml:lang":"EN"}]}],"/document-link":[{"/category":[{"@code":"A02"},{"@code":"A03"},{"@code":"A04"},{"@code":"A05"},{"@code":"A06"}],"/language":[{"@code":"EN"}],"/title/narrative":[{"1":"Egypt 2000004001: CROWN Project Design Report July 2024","@xml:lang":"EN"}],"@format":"APPLICATION/PDF","@url":"https://operations.ifad.org/documents/654016/ff00d