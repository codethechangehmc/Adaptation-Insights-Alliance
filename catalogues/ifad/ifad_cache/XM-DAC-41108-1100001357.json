{"xson":[{"/iati-activities/iati-activity":[{"/activity-date":[{"@iso-date":"2008-04-24","@type":"2"},{"@iso-date":"2013-12-31","@type":"4"}],"/activity-status@code":"4","/collaboration-type@code":"2","/contact-info":[{"/organisation/narrative":[{"1":"International Fund for Agricultural Development","@xml:lang":"EN"}],"/person-name/narrative":[{"1":"Gbossa, Nadine Dominique Ms","@xml:lang":"EN"}],"/telephone":[{"1":"+390654591"}],"/website":[{"1":"http://www.ifad.org"}],"@type":"1"}],"/default-aid-type":[{"@code":"C01","@vocabulary":"1"}],"/default-tied-status@code":"5","/description":[{"/narrative":[{"1":"The goal is to support the pro-poor reform agenda within the overall Reform. This will be achieved through three objectives: (i) to facilitate the development of pro-poor policies and programmes within MAIF and the Rodrigues Regional Authority (RRA) and assist MAIF to manage marine resources sustainably; (ii) to sustainably improve the livelihoods of coastal communities threatened by over-exploitation of the marine environment; and (iii) to assist rural households, including smallholder cane planters to diversify their income-generating enterprises, and improve their employment prospects.The programme will deepen IFAD engagement in agricultural, rural poverty and marine resource policy and institutional reform, by continuing implementation support and technical assistance being provided under the current RDP.","@xml:lang":"EN"}]}],"/document-link":[{"/category":[{"@code":"A12"}],"/description/narrative":[{"1":"More information on how IFAD publish IATI data to ensure the effectiveness of development.","@xml:lang":"EN"}],"/language":[{"@code":"EN"}],"/title/narrative":[{"1":"IATI documentation on IFAD corporate website","@xml:lang":"EN"}],"@format":"TEXT/HTML","@url":"/en/iati"},{"/category":[{"@code":"A12"}],"/description/narrative":[{"1":"The IFAD website includes a specific page for this project.  More information can be found here.","@xml:lang":"EN"}],"/language