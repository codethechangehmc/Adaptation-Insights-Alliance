{"xson":[{"/iati-activities/iati-activity":[{"/activity-date":[{"@iso-date":"2011-09-15","@type":"2"},{"@iso-date":"2021-06-30","@type":"4"}],"/activity-status@code":"4","/collaboration-type@code":"2","/contact-info":[{"/organisation/narrative":[{"1":"International Fund for Agricultural Development","@xml:lang":"EN"}],"/person-name/narrative":[{"1":"Rispoli, Francesco Maria","@xml:lang":"EN"}],"/telephone":[{"1":"+390654591"}],"/website":[{"1":"http://www.ifad.org"}],"@type":"1"}],"/default-aid-type":[{"@code":"C01","@vocabulary":"1"}],"/default-tied-status@code":"5","/description":[{"/narrative":[{"1":"This nationwide project will assist smallholder producers - in particular woman-headed households - in taking advantage of concrete income opportunities in pro-poor cash crop value chains in partnership with private operators.  it will mainly focus on the proven export crops of coffee and tea, the promising export crop of silk and horticultural crops principally for local and regional markets.The project aims at changing the mechanism determining the farmgate price of tea leaves by raising the farmers' negotiating position. Its institutional objective is strengthened producer cooperatives as full-fledged economic partners of the private sector.The project goal is to raise smallholder farmers' income. Its development objective is to promote sustainable increased returns to farmers from key export-driven agricultural value chains through increased volumes and quality of production, improved marketing and effective farmer organisationsPRICE contributed to the creation of rural enterprises and employments mainly in tea, coffee, horticulture and sericulture components. A example, the project supported the construction of Coffee Washing Stations in rural areas thus creating small enterprises  giving many employments opportunities. The tea components also contributed to the establishment of tea factories that employ many people in rural areas. Many small and medium enterprises and employments were also created in the horticulture component. Small processing plants were established and some of them are exporting to international markets, thus creating many employments. Same for the sericulture component. For the first time a sericulture factory was put in place and is employing many people from the silk farmers who supply the factory to the employees of the factory.","@xml:lang":"EN"}]}],"/document-link":[{"/category":[{"@code":"A12"}],"/description/narrative":[{"1":"More information on how IFAD publish IATI data to ensure the effectiveness of development.","@xml:lang":"EN"}],"/language":[{"@code":"EN"}],"/title/narrative":[{"1":"IATI documentation on IFAD corporate website","@xml:lang":"EN"}],"@format":"TEXT/HTML","@url":"/en/iati"},{"/category":[{"@code":"A12"}],"/description/narrative":[{"1":"The IFAD website includes a specific page for this project.  More information can be found here.","@xml:lang":"EN"}],"/language":[{"@code":"EN"}],"/title/narrative":[{"1":"Project page on IFAD corporate website","@xml:lang":"EN"}],"@format":"TEXT/HTML","@url":"/w/projects/1550"}],"/iati-identifier":"XM-DAC-41108-1100001550","/location":[{"/description/narrative":[{"1":"This point represents the centroid of the project area. For more detailed geographic information, please refer to the project page on the IFAD website.","@xml:lang":"EN"}],"/exactness@code":"1","/location-reach@code":"1","/name/narrative":[{"1":"Agricultural Development: Project for Rural Income through Exports","@xml:lang":"EN"}],"/point/pos":"-2.0027242239238254 29.922818548911998","/point@srsName":"http://www.opengis.net/def/crs/EPSG/0/4326"}],"/other-identifier":[{"@ref":"1100001550","@type":"A1"}],"/participating-org":[{"/narrative":[{"1":"International Fund for Agricultural Development","@xml:lang":"EN"}],"@activity-id":"XM-DAC-41108-1100001550","@ref":"XM-DAC-41108","@role":"1","@type":"40"}],"/recipient-country":[{"@code":"RW","@percentage":100}],"/reporting-org/narrative