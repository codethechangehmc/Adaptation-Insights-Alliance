{"xson":[{"/iati-activities/iati-activity":[{"/activity-date":[{"@iso-date":"2006-12-14","@type":"2"},{"@iso-date":"2021-03-31","@type":"4"}],"/activity-status@code":"4","/collaboration-type@code":"2","/contact-info":[{"/department/narrative":[{"1":"ESA","@xml:lang":"EN"}],"/email":[{"1":"m.sakphouseth@ifad.org"}],"/job-title/narrative":[{"1":"Country Director","@xml:lang":"EN"}],"/organisation/narrative":[{"1":"International Fund for Agricultural Development","@xml:lang":"EN"}],"/person-name/narrative":[{"1":"Meng, Sakphouseth","@xml:lang":"EN"}],"/telephone":[{"1":"+390654591"}],"/website":[{"1":"http://www.ifad.org"}],"@type":"1"}],"/default-aid-type":[{"@code":"C01","@vocabulary":"1"}],"/default-tied-status@code":"5","/description":[{"/narrative":[{"1":"Key Programme Objectives: The programme will seek to provide targeted rural entrepreneurs (including the rural poor, women and youth) with improved skills and knowledge for their rural livelihoods and better access to markets, in order to increase their household food sufficiency and cash incomes.Policy and Institutional Objectives: In line with the Public Service Reform Programme for improving civil service performance it is anticipated that SIDO will become more responsive and effective in providing enterprise development services, especially in the rural areas. The programme also aims to support the Local Government Reform Programme by building capacity for supporting enterprise development in the rural areas. Finally, the Small and Medium Enterprise Policy will be under pressure to ensure that rural entrepreneurs have access to information, services and markets for improved economic activity.","@xml:lang":"EN"}]}],"/document-link":[{"/category":[{"@code":"A12"}],"/description/narrative":[{"1":"More information on how IFAD publish IATI data to ensure the effectiveness of development.","@xml:lang":"EN"}],"/language":[{"@code":"EN"}],"/title/narrative":[{"1":"IATI documentation on IFAD corporate website","@xml:l