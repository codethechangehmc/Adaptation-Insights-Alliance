{"xson":[{"/iati-activities/iati-activity":[{"/activity-date":[{"@iso-date":"2019-09-12","@type":"2"},{"@iso-date":"2026-04-10","@type":"4"}],"/activity-status@code":"4","/collaboration-type@code":"2","/contact-info":[{"/department/narrative":[{"1":"ESA","@xml:lang":"EN"}],"/email":[{"1":"m.chitima@ifad.org"}],"/job-title/narrative":[{"1":"Hub Director","@xml:lang":"EN"}],"/organisation/narrative":[{"1":"International Fund for Agricultural Development","@xml:lang":"EN"}],"/person-name/narrative":[{"1":"Chitima, Mawira","@xml:lang":"EN"}],"/telephone":[{"1":"+390654591"}],"/website":[{"1":"http://www.ifad.org"}],"@type":"1"}],"/default-aid-type":[{"@code":"C01","@vocabulary":"1"}],"/default-tied-status@code":"5","/description":[{"/narrative":[{"1":"General objective: To Improve Livelihood Resilience of Pastoral and Agro-Pastoral Communities in Ethiopia. The project will take a spatial and landscape approach to planning productive natural resource management, and support government efforts to strengthen planning processes across administrative boundaries. Building on the experience and results of PCDP in institutional development and service delivery, the community-driven development approach will be integral part of the project¿s highlevel inclusive and participatory planning mechanism, enabling structural and transformative investments in land use, range and market development. The value chain approach will leverage private investment, productivity gains and commercial linkages along value chains, enabling target groups to sustain and continue scaling up results after completion. Strong market demand will be a key criterion for activity selection. The project will be implemented through four integrated components.The project will take a spatial and landscape approach to planning productive natural resource management, and support government efforts to strengthen planning processes across administrative boundaries. Building on the experience and results of PCDP in institutional development and service delivery, the community-driven development approach will be integral part of the project¿s highlevel inclusive and participatory planning mechanism, enabling structural and transformative investments in land use, range and market development. The value chain approach will leverage private investment, productivity gains and commercial linkages along value chains, enabling target groups to sustain and continue scaling up results after completion. Strong market demand will be a key criterion for activity selection. The project will be implemented through four integrated components.","@xml:lang":"EN"}]}],"/document-link":[{"/category":[{"@code":"A02"},{"@code":"A07"},{"@code":"A08"}],"/language":[{"@code":"EN"}],"/title/narrative":[{"1":"Ethiopia 2000001598: LLRP CI Supervision Report August 2024","@xml:lang":"EN"}],"@format":"APPLICATION/PDF","@url":"https://operations.ifad.org/documents/654016/a9c2654b-a24e-434f-94ae-db72190f3052"},{"/category":[{"@code":"A02"},{"@code":"A07"},{"@code":"A08"}],"/language":[{"@code":"EN"}],"/title/narrative":[{"1":"Ethiopia 2000001598: LLRP CI Supervision Report December 2025","@xml:lang":"EN"}],"@format":"APPLICATION/PDF","@url":"https://operations.ifad.org/documents/654016/f243d390-775c-45ad-ad86-af194205170f"},{"/category":[{"@code":"A07"},{"@code":"A08"}],"/language":[{"@code":"EN"}],"/title/narrative":[{"1":"Ethiopia 2000001598: LLRP Project Completion Report July 2026","@xml:lang":"EN"}],"@format":"APPLICATION/PDF","@url":"https://operations.ifad.org/documents/654016/c3c3f5ba-2e2a-4b79-88fc-428ef18be526"},{"/category":[{"@code":"A12"}],"/description/narrative":[{"1":"More information on how IFAD publish IATI data to ensure the effectiveness of development.","@xml:lang":"EN"}],"/language":[{"@code":"EN"}],"/title/narrative":[{"1":"IATI documentation on IFAD corporate website","@xml:lang":"EN"}],"@format":"TEXT/HTML","@url":"/en/iati"},{"/category":[{"@code":"A12"}],"/description/narrative":[{"1"