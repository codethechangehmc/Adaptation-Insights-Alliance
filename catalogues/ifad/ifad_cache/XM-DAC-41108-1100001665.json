{"xson":[{"/iati-activities/iati-activity":[{"/activity-date":[{"@iso-date":"2015-04-22","@type":"2"},{"@iso-date":"2024-03-31","@type":"4"}],"/activity-status@code":"4","/collaboration-type@code":"2","/contact-info":[{"/department/narrative":[{"1":"ESA","@xml:lang":"EN"}],"/email":[{"1":"f.rispoli@ifad.org"}],"/job-title/narrative":[{"1":"Country Director","@xml:lang":"EN"}],"/organisation/narrative":[{"1":"International Fund for Agricultural Development","@xml:lang":"EN"}],"/person-name/narrative":[{"1":"Rispoli, Francesco","@xml:lang":"EN"}],"/telephone":[{"1":"+390654591"}],"/website":[{"1":"http://www.ifad.org"}],"@type":"1"}],"/default-aid-type":[{"@code":"C01","@vocabulary":"1"}],"/default-tied-status@code":"5","/description":[{"/narrative":[{"1":"The goal of the programme is to reduce the poverty of targeted poor rural households in a sustainable way. The Programme will be national in scope with its initiatives being started through the development of small/medium dam irrigation schemes as identified by GoS in the CAADP Compact and the commercialization of selected government farms using public private partnerships (PPPs). It will target vulnerable households, women and young people.Key aspects in the management of the programme will be support for the development of an effective MIS system for agriculture that is needed to support focused Government initiatives in the smallholder sector and service delivery. These initiatives will include capacity building and policy dialogue that will facilitate the long term adoption by Government of successful approaches that will emerge from SMLPP i.e. scaling up. The focus on poor rural people will make sure that they are included in and benefit from various development processes as the viability of the smallholder agricultural sector increases. The targeting strategy recognises that there needs to be a mix of poor and better off people in development.","@xml:lang":"EN"}]}],"/document-link":[{"/category":[{"@code":"A02"},{"@code":"A07"},{"@code":"A08"}],"/language":[{"@code":"EN"}],"/title/narrative":[{"1":"Eswatini 1100001665: SMLP Supervision Report June 2023","@xml:lang":"EN"}],"@format":"APPLICATION/PDF","@url":"https://operations.ifad.org/documents/654016/4833473c-2915-4325-a447-a96c4dcea92e"},{"/category":[{"@code":"A02"},{"@code":"A07"},{"@code":"A08"}],"/language":[{"@code":"EN"}],"/title/narrative":[{"1":"Eswatini 1100001665: SMLP Supervision Report September 2022","@xml:lang":"EN"}],"@format":"APPLICATION/PDF","@url":"https://operations.ifad.org/documents/654016/085d4961-1090-440b-ac26-fc6e52e0c03c"},{"/category":[{"@code":"A07"},{"@code":"A08"}],"/language":[{"@code":"EN"}],"/title/narrative":[{"1":"Eswatini 1100001665: SMLP Project Completion Report","@xml:lang":"EN"}],"@format":"APPLICATION/PDF","@url":"https://operations.ifad.org/documents/654016/c0caa38e-edd2-486d-b3d0-2b9fce101e95"},{"/category":[{"@code":"A12"}],"/description/narrative":[{"1":"More information on how IFAD publish IATI data to ensure the effectiveness of development.","@xml:lang":"EN"}],"/language":[{"@code":"EN"}],"/title/narrative":[{"1":"IATI documentation on IFAD corporate website","@xml:lang":"EN"}],"@format":"TEXT/HTML","@url":"/en/iati"},{"/category":[{"@code":"A12"}],"/description/narrative":[{"1":"The IFAD website includes a specific page for this project.  More information can be found here.","@xml:lang":"EN"}],"/language":[{"@code":"EN"}],"/title/narrative":[{"1":"Project page on IFAD corporate website","@xml:lang":"EN"}],"@format":"TEXT/HTML","@url":"/w/projects/1665"}],"/iati-identifier":"XM-DAC-41108-1100001665","/location":[{"/description/narrative":[{"1":"This point represents the centroid of the project area. For more detailed geographic information, please refer to the project page on the IFAD website.","@xml:lang":"EN"}],"/exactness@code":"1","/location-reach@code":"1","/name/narrative":[{"1":"Marketing/Storage/Processing: Smallholder Market-led Project","@xml:lang":"EN"}],"/poi