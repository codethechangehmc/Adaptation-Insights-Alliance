{"xson":[{"/iati-activities/iati-activity":[{"/activity-date":[{"@iso-date":"2013-12-11","@type":"2"},{"@iso-date":"2021-03-31","@type":"4"}],"/activity-status@code":"4","/collaboration-type@code":"2","/contact-info":[{"/organisation/narrative":[{"1":"International Fund for Agricultural Development","@xml:lang":"EN"}],"/person-name/narrative":[{"1":"Rispoli, Francesco Maria","@xml:lang":"EN"}],"/telephone":[{"1":"+390654591"}],"/website":[{"1":"http://www.ifad.org"}],"@type":"1"}],"/default-aid-type":[{"@code":"C01","@vocabulary":"1"}],"/default-tied-status@code":"5","/description":[{"/narrative":[{"1":"PASP development objective is to increase smallholder and rural labourer incomes (including women, youth and vulnerable groups) from CIP crop  and diary businesses, especially those related to aggregating production for markets, supporting transformation, and creating value-added to enable smallholder to capture a higher share of the value. The project''s primary focus will be the facilitation of inclusive business activities that can thrive on increased agricultural production form CIP crops and diary development . Investments in improved post-harvesting procedure, drying, processing, storage, distribution, logistics and capacity building of cooperatives farmers organizations are expected to generate reductions in product losses that are just as important as improved crop yields in preserving food production and localized value addition in a changing and more uncertain climate.","@xml:lang":"EN"}]}],"/document-link":[{"/category":[{"@code":"A05"}],"/language":[{"@code":"EN"}],"/title/narrative":[{"1":"2021-MinistÃ¨re des Finances et de la Planification Economique-AUDIT_REPORT","@xml:lang":"EN"}],"@format":"APPLICATION/PDF","@url":"https://operations.ifad.org/documents/654016/2c6e376a-6650-4d73-b205-e37d7e9d9499"},{"/category":[{"@code":"A12"}],"/description/narrative":[{"1":"More information on how IFAD publish IATI data to ensure the effectiveness of development.",